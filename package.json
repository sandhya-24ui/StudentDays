{
  "name": "studentdays-app",
  "version": "1.0.0",
  "private": true,
  "description": "StudentDays.co Android app (Capacitor)",
  "scripts": {
    "assets": "npx capacitor-assets generate --android --iconBackgroundColor '#050505' --splashBackgroundColor '#050505'",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "apk": "cd android && ./gradlew assembleDebug",
    "aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "engines": { "node": ">=22" }
}
